# Ambiente: homologacao (produção restrita, sem valor fiscal) ou producao
NFSE_AMBIENTE=homologacao

# Certificado digital A1 do prestador (e-CNPJ .pfx/.p12) — nunca versionar
NFSE_PFX_PATH=certificado/empresa.pfx
NFSE_PFX_SENHA=

# Prestador (emitente): o padrão já é a Conexão Ágil (CNPJ 29.978.652/0001-87, IM 10733590010, BH).
# Contato, endereço e dados bancários são editados na tela Config (ficam em data/emitente.json)
# ou preenchidos automaticamente ao importar as notas antigas. Só descomente para sobrescrever.
# PRESTADOR_CNPJ=29978652000187
# PRESTADOR_IM=10733590010
# PRESTADOR_FANTASIA=Conexão Ágil
# Simples Nacional: 1 não optante, 2 MEI, 3 ME/EPP
PRESTADOR_OP_SIMPLES=3
# Apuração ME/EPP: 1 federais e municipal pelo SN
PRESTADOR_REG_AP_SN=1
# Regime especial: 0 nenhum
PRESTADOR_REG_ESP=0

# Município emissor (IBGE) — Belo Horizonte
NFSE_MUNICIPIO_EMISSOR=3106200
NFSE_SERIE=1

# Serviço padrão
# 08.02.01 Instrução, treinamento, orientação pedagógica e educacional
SERVICO_TRIB_NAC=080201
SERVICO_TRIB_MUN=001
SERVICO_NBS=
SERVICO_LOCAL_PRESTACAO=3106200
# Alíquota: deixe vazio; o município parametriza e a Sefin calcula (informar quando não pede gera E0617)
SERVICO_ALIQUOTA=
# % aproximado de tributos do Simples (Lei 12.741/2012) — use a alíquota efetiva da sua faixa
SERVICO_PTOTTRIB_SN=6.00
# Texto acrescentado ao fim de toda descrição (use \n para quebrar linha)
SERVICO_RODAPE=Dados Bancários\nBanco Inter - 077

PORT=3333
